{
  "manifest_version": 3,
  "name": "Little Tusk",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "description": "A friendly little elephant that helps you find your way on any website.",
  "permissions": [
    "storage",
    "offscreen",
    "scripting",
    "tts"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/tusk.svg",
        "assets/tusk-pointing.svg"
      ],
      "matches": [
        "<all_urls>"
      ]
    },
    {
      "resources": [
        "pages/setup.html"
      ],
      "matches": [
        "https://thejeswi.github.io/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ]
    },
    {
      "resources": [
        "pages/compose.html",
        "chunks/*"
      ],
      "matches": [
        "<all_urls>"
      ],
      "use_dynamic_url": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_title": "Little Tusk: click to show Tusk again"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
